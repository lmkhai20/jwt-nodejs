<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Latest compiled JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="user-info-container">
                <form method="POST" action="/users/create-user">
                                <div class="mb-3 col-6 mt-3">
                                    <label for="email" class="form-label">Email address</label>
                                    <input name="email" type="email" class="form-control" id="email" required>
                                </div>
                                <div class="col-6"></div>
                                <div class="mb-3 col-6">
                                    <label for="password" class="form-label">Password</label>
                                    <input name="password" type="password" class="form-control" id="password" required>
                                </div>
                                <div class="col-6"></div>
                                <div class="mb-3 col-6">
                                    <label for="username" class="form-label">Username</label>
                                    <input name="username" type="text" class="form-control" id="username" required>
                                </div>
                                <div class="col-6"></div>
                                <div class="col-6">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                        
                </form>
            </div>
            <div class="list-user-container mt-4">
                <h2>All Users</h2>
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Email</th>
                            <th scope="col">Username</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(let i=0; i < userList.length; i++) { %>
                            <input name="id" hidden value="<%=userList[i].id %>" />
                        <tr>
                            <th scope="row"><%= userList[i].id %></th>
                            <td><%= userList[i].email %></td>
                            <td><%= userList[i].username %></td>
                            <td>
                                <a href="/users/get-user-edit/<%=userList[i].id %>" id="edit" class="btn btn-warning">Edit</a>
                                <a href="/users/delete-user/<%=userList[i].id %>" id="delete" class="btn btn-danger">Delete</a>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>